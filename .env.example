# Copy to .env.local for local development. Never commit .env.local or share secret keys in chat.
# Leave BOTH Supabase public fields empty for DEMO mode: sample listings, no saved enquiries.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL, from Connect / API settings.
NEXT_PUBLIC_SUPABASE_URL=
# Use the modern sb_publishable_... key here. Legacy anon JWT also works.
# Variable name retained for compatibility with V2.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY: use modern sb_secret_... key here (or legacy service_role JWT).
# Required for live lead submission in V3. NEVER prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Same lowercase login email as Supabase Authentication user AND public.admins.
ADMIN_EMAILS=

# OPTIONAL notification services. Leave blank for the first deployment.
# Leads remain in the admin dashboard without notifications.
# Alerts contain only a generic notice and dashboard link, not customer contact details.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFY_EMAIL=
